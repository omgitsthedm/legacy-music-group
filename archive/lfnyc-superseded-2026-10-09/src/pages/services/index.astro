---
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import Cta from '../../components/Cta.astro';
import { services } from '../../data/site';
---
<Layout title="Websites, tech support & software you own" description="Start with the problem. Explore custom websites, NYC technology support, free consulting and focused business software from Little Fight NYC.">
  <div class="shell"><header class="page-heading"><p class="eyebrow">What we do</p><h1>Good tech.<br />Built around you.</h1><p>Get found. Get back to work. Stop entering the same thing twice. We start with the job your business needs done.</p></header></div>
  <section class="services-section section"><div class="shell"><div class="service-list">{services.map(service => <a class="service-row" href={`/services/${service.slug}/`}><span class="service-number">{service.number}</span><div><h2>{service.short}</h2><p>{service.description}</p></div><span class="service-arrow"><Arrow /></span></a>)}</div></div></section>
  <section class="section shell process"><div><p class="eyebrow muted">First, a conversation</p><h2>You don’t need<br />the technical answer.</h2></div><div><p>You need a clear picture of what is wrong, what a fix would involve, and what it will cost.</p><p>Consulting is always free. We agree on the scope before any paid work begins. If your current tools can do the job, we say so.</p><a class="text-link" href="/contact/">Tell us what’s happening <Arrow /></a></div></section>
  <Cta />
</Layout>
