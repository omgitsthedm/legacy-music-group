{
  "name": "legacy-music-group",
  "private": true,
  "version": "0.1.0",
  "description": "Legacy Music Group \u2014 Deep Ellum recording studio + artist development brand",
  "homepage": "https://legacy-music-group.netlify.app",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 52764 --strictPort",
    "build": "tsc -b && vite build && node scripts/prerender-meta.mjs && node scripts/build-sitemap.mjs && node scripts/finalize.mjs",
    "lint": "eslint .",
    "test:accessibility-shell": "node scripts/verify-accessibility-shell.mjs",
    "test:analytics-consent": "node scripts/verify-analytics-consent.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc -b",
    "test:design": "node scripts/verify-design-preservation.mjs",
    "test": "npm run test:accessibility-shell && npm run test:analytics-consent && npm run test:design",
    "verify": "npm run lint && npm run build && npm test",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lucide-react": "0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "autoprefixer": "10.4.23",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "vite": "7.3.7",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
