{
  "name": "little-fight-nyc-legacy-property",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Little Fight NYC static service website on the Legacy Netlify property",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 52761",
    "build": "astro build && node scripts/finalize.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint src scripts tests astro.config.mjs eslint.config.mjs playwright.config.mjs",
    "typecheck": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": { "astro": "7.3.8" },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
