---
import { work, business } from '../data/site';
import Arrow from './Arrow.astro';
---
<div class="work-grid">
  {work.map((project) => <article class="work-item">
    <a class="work-image" href={business.officialUrl + project.source} aria-label={`Read about ${project.name} on Little Fight NYC's main site`}>
      <img src={`/images/${project.image}`} alt={`Actual desktop capture of the ${project.name} website`} width="1008" height="700" loading="lazy" decoding="async" />
      <span class="round-arrow"><Arrow /></span>
    </a>
    <p class="eyebrow muted">{project.category}</p>
    <h3><a href={business.officialUrl + project.source}>{project.name}</a></h3>
    <p>{project.description}</p>
    <a class="text-link" href={project.url}>Visit website <span aria-hidden="true">↗</span></a>
  </article>)}
</div>
