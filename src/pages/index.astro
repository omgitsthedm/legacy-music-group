---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Work from '../components/Work.astro';
import Cta from '../components/Cta.astro';
import FaqList from '../components/FaqList.astro';
import { services, faqs } from '../data/site';
import { Image } from 'astro:assets';
import shop from '../assets/imagery/shop-systems-hero.webp';
---
<Layout title="Small business websites & tech support" description="Custom websites, hands-on tech support and software you own. Little Fight NYC makes technology fit your small business. Consulting is always free.">
  <section class="hero shell">
    <div class="hero-copy"><p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span> Serious tech. Small business.</p>
      <h1>Small crew.<br /><span>Heavy pull.</span></h1>
      <p class="hero-intro">A website that brings people in.<br />Technology that keeps you moving.</p>
      <p class="hero-description">We build websites, fix what’s broken, and make the tools fit your business. Right here in your corner.</p>
      <div class="hero-actions"><a class="button primary" href="/services/websites/">Let’s build your website <Arrow /></a><a class="urgent-link" href="/services/it-support/">Something broken? Get help <span aria-hidden="true">↗</span></a></div>
      <p class="hero-footnote">New York roots. Independent business everywhere.</p>
    </div>
    <figure class="hero-image"><Image src={shop} widths={[480,800,1200]} sizes="(max-width: 620px) calc(100vw - 40px), (max-width: 1440px) 44vw, 612px" format="webp" quality={80} loading="eager" fetchpriority="high" alt="Shelves, a work counter and everyday business tools inside an independent shop" /><figcaption><span class="eyebrow">For the places that</span><strong>make a neighborhood.</strong><span class="photo-coordinate" aria-hidden="true">NYC ↗</span></figcaption></figure>
  </section>
  <div class="promise-strip"><div class="shell"><p>Your business. Your code. Your call.</p><p>Free consulting <span aria-hidden="true">/</span> Work you own <span aria-hidden="true">/</span> People you can reach</p></div></div>
  <section class="section shell" id="work"><div class="section-head"><div><p class="eyebrow muted">A few familiar fights</p><h2>Real businesses.<br />Their own kind of website.</h2></div><a class="text-link" href="/work/">Explore our work <Arrow /></a></div><Work /></section>
  <section class="services-section section"><div class="shell"><div class="section-head"><div><p class="eyebrow muted">What’s in your way?</p><h2>Let’s get it moving.</h2></div><p class="section-intro">Start with the problem. We’ll find the right size of fix.</p></div><div class="service-list">{services.map(service => <a class="service-row" href={`/services/${service.slug}/`}><span class="service-number">{service.number}</span><div><h3>{service.short}</h3><p>{service.description}</p></div><span class="service-arrow"><Arrow /></span></a>)}</div></div></section>
  <section class="section shell process" id="process"><div class="process-heading"><p class="eyebrow muted">How we work</p><h2>Less runaround.<br />More done.</h2><p>Talk to the people doing the work. See it working. Know what you own.</p><a class="text-link" href="/contact/">Start with a free conversation <Arrow /></a></div><ol class="process-steps"><li><span>01</span><div><h3>Show us the friction.</h3><p>We look at what you have, what isn’t working, and what the business needs next.</p></div></li><li><span>02</span><div><h3>Agree on the right work.</h3><p>A clear scope, a clear price, and a working version to review before it goes live.</p></div></li><li><span>03</span><div><h3>Leave you in control.</h3><p>Your code, data, domain and documentation. A proper handover, with help when you need it.</p></div></li></ol></section>
  <section class="section shell home-faq"><div><p class="eyebrow muted">Before we start</p><h2>Good questions.</h2><a class="text-link" href="/faq/">All the answers <Arrow /></a></div><FaqList items={faqs.slice(2,6)} /></section>
  <Cta />
</Layout>
