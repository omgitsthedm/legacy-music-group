---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Cta from '../components/Cta.astro';
import FaqList from '../components/FaqList.astro';
import { Image } from 'astro:assets';
import { serviceImages } from '../data/images';
import { services, faqs } from '../data/site';
---
<Layout title="Recording studio in Deep Ellum, Dallas" description="Find your next session at Legacy Music Group in Deep Ellum, Dallas. Explore recording, mixing, mastering and custom production, then book with the studio.">
<section class="shell hero"><div class="hero-copy"><p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span> Deep Ellum · Dallas, Texas</p><h1>Your sound.<br /><em>Your legacy.</em></h1><p class="hero-intro">A recording studio for the<br class="desktop-break" /> music you need to make.</p><p class="hero-description">Recording, mixing and production in the heart of Deep Ellum. Bring your voice. Find your next session.</p><div class="actions"><a class="button primary" href="/book/">Book a session <Arrow /></a><a class="text-link" href="/services/">Explore services <Arrow /></a></div><p class="hero-footnote">2815 Main St, Suite A · Dallas, TX</p></div><figure class="hero-image"><Image src={serviceImages.microphone} widths={[480,768,1200]} sizes="(max-width: 620px) calc(100vw - 40px), 45vw" quality={80} format="webp" alt="Microphone and pop filter at Legacy Music Group’s recording studio" loading="eager" fetchpriority="high" /><figcaption><span class="eyebrow">A place to create.</span><span>Legacy Music Group <span aria-hidden="true">↗</span></span></figcaption></figure></section>
<div class="signal-strip"><div class="shell"><span>RECORD</span><span aria-hidden="true">/</span><span>MIX</span><span aria-hidden="true">/</span><span>CREATE</span><a href="/pricing/">Recording listed at $75/hr <span aria-hidden="true">↗</span></a></div></div>
<section class="section shell"><div class="section-head"><div><p class="eyebrow">01 / What we do</p><h2>From the first take<br />to the final <em>detail.</em></h2></div><p>Choose the work your project needs. Keep the music at the center.</p></div><div class="service-list">{services.map(service=><a class="service-row" href={`/services/${service.slug}/`}><span class="service-number">{service.number}</span><div><h3>{service.short}</h3><p>{service.lead}</p></div><span class="service-arrow"><Arrow /></span></a>)}</div></section>
<section class="studio-feature"><div class="shell studio-feature-grid"><Image src={serviceImages.room} widths={[480,768,1024]} sizes="(max-width: 750px) calc(100vw - 40px), 55vw" quality={80} format="webp" alt="The control room at Legacy Music Group, with its mixing desk and seating" loading="lazy" /><div><p class="eyebrow">02 / The studio</p><h2>In the heart<br />of <em>Deep Ellum.</em></h2><p>Legacy is a recording studio and production company on Main Street. A place to focus on the next take, hear the whole picture and work through an idea.</p><a class="text-link" href="/studio/">Take a closer look <Arrow /></a></div></div></section>
<section class="section shell process"><div><p class="eyebrow">03 / Your next session</p><h2>A clear way<br /><em>into the room.</em></h2><p>Booking stays with Legacy’s existing calendar. Pick your session there and review the details before paying.</p><a class="text-link" href="/book/">How booking works <Arrow /></a></div><ol class="process-steps"><li><span>01</span><div><h3>Choose your session.</h3><p>Select a service, duration and engineer. Use Any if you have no engineer preference.</p></div></li><li><span>02</span><div><h3>Find your time.</h3><p>Check available dates in the live calendar and choose what fits.</p></div></li><li><span>03</span><div><h3>Review and confirm.</h3><p>Check the current price and terms, complete checkout and look for your booking confirmation.</p></div></li></ol></section>
<section class="section shell home-faq"><div><p class="eyebrow">Before you book</p><h2>Good questions.<br /><em>Clear answers.</em></h2><a class="text-link" href="/faq/">All questions <Arrow /></a></div><FaqList items={faqs.slice(0,4)} /></section><Cta />
</Layout>
