---
import Layout from '../../layouts/Layout.astro';
import Cta from '../../components/Cta.astro';
import Arrow from '../../components/Arrow.astro';
import FaqList from '../../components/FaqList.astro';
import { Image } from 'astro:assets';
import { serviceImages } from '../../data/images';
import { services, business } from '../../data/site';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const { service } = Astro.props;
const schema={'@type':'Service',name:service.short,description:service.description,url:new URL(`/services/${service.slug}/`,Astro.site).href,provider:{'@id':`${business.officialUrl}/#studio`},areaServed:{'@type':'City',name:'Dallas'}};
---
<Layout title={`${service.short} in Dallas`} description={service.description} schema={schema}>
<section class="shell service-hero"><div><p class="eyebrow">{service.number} / {service.short}</p><h1>{service.title}</h1><p>{service.lead}</p><div class="actions"><a class="button primary" href="/book/">Find a session <Arrow /></a><a class="text-link" href={`/contact/?service=${service.slug}`}>Ask a question</a></div></div><Image src={serviceImages[service.image]} widths={[480,768,1024]} sizes="(max-width:620px) calc(100vw - 40px), 44vw" format="webp" quality={80} alt={service.alt} loading="eager" fetchpriority="high" /></section>
<section class="section shell service-body"><div><p class="eyebrow">A focused session</p><h2>The work.</h2><p>{service.body}</p><div class="fit-note"><h3>Before you arrive</h3><p>{service.preparation}</p></div></div><div><p class="eyebrow">Start here</p><ul class="check-list">{service.includes.map(item=><li>{item}</li>)}</ul><p class="small">Confirm scope, current pricing and availability directly with the studio.</p><a class="text-link" href="/pricing/">Published starting rates <Arrow /></a></div></section>
<section class="section shell home-faq"><div><p class="eyebrow">A little clarity</p><h2>Before<br /><em>the session.</em></h2></div><FaqList items={[{question:service.question,answer:service.answer},{question:'Where is the studio?',answer:'2815 Main St, Suite A, Dallas, TX 75226, in Deep Ellum. Call (214) 377-9729 for arrival or session questions.'}]} /></section><Cta />
</Layout>
