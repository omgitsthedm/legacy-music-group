---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { business } from '../data/site';
import { topics } from '../lib/contact';
---
<Layout title="Contact the studio in Deep Ellum" description="Contact Legacy Music Group in Deep Ellum. Email info@legacymusicgroup.com or call (214) 377-9729 about recording, production or an upcoming session.">
  <div class="shell"><header class="page-heading"><p class="eyebrow">Talk to the studio</p><h1>What are you<br /><em>working on?</em></h1><p>Tell us about the track, the project or the session you have in mind.</p></header>
    <div class="contact-grid"><aside class="contact-direct"><h2>Let’s talk music.</h2><a href={`mailto:${business.email}`}>{business.email} <span aria-hidden="true">↗</span></a><a href={`tel:${business.phone}`}>{business.displayPhone}</a><a href={business.mapsUrl}>Get directions <span aria-hidden="true">↗</span></a><p>2815 Main St, Suite A, Dallas, TX 75226. Session reservations and payments stay on Legacy’s booking page.</p><p class="small">Please leave passwords, payment details and other sensitive information out of your message.</p></aside>
      <div><form id="contact-brief" class="brief-form" hidden><h2>Get your thoughts together.</h2><p>This prepares an email in your browser. You review it in your email app and choose when to send it.</p>
        <div class="field-row"><div class="field"><label for="brief-name">Your name</label><input id="brief-name" name="name" autocomplete="name" required maxlength="100" /></div><div class="field"><label for="brief-email">Your email</label><input id="brief-email" name="email" type="email" autocomplete="email" required maxlength="254" /></div></div>
        <div class="field"><label for="brief-service">What do you need?</label><select id="brief-service" name="service">{Object.entries(topics).map(([value,label])=><option value={value}>{label}</option>)}</select></div>
        <div class="field"><label for="brief-message">Tell us about your project</label><textarea id="brief-message" name="message" rows="5" maxlength="1200" required aria-describedby="brief-hint"></textarea><p class="form-note" id="brief-hint">A few sentences are plenty. Up to 1,200 characters.</p></div>
        <button class="button primary" type="submit">Prepare my email <Arrow /></button><p class="form-note">Nothing is sent or saved by this page.</p><p id="brief-error" role="alert" class="status"></p>
      </form>
      <noscript><h2>Email works, too.</h2><p>Send a few sentences about what you need to <a class="text-link" href={`mailto:${business.email}`}>{business.email}</a>. Your name, project and a few session details are enough to start.</p></noscript>
      <section id="brief-result" class="draft-result" hidden aria-label="Your prepared email"><h2>Your draft is ready.</h2><p role="status">Nothing has been sent. Open your email app to review and send, or copy the text below.</p><pre id="draft-text" tabindex="0"></pre><div class="draft-actions"><a id="draft-link" class="button primary" href={`mailto:${business.email}`}>Open my email app <Arrow /></a><button id="copy-brief" class="button secondary" type="button">Copy brief</button></div><p id="copy-status" role="status" class="form-note"></p></section>
      </div>
    </div>
  </div>
  <script>
    import { buildEmailDraft, topics } from '../lib/contact';
    const form = document.querySelector<HTMLFormElement>('#contact-brief');
    const result = document.querySelector<HTMLElement>('#brief-result');
    const error = document.querySelector<HTMLElement>('#brief-error');
    const draftText = document.querySelector<HTMLElement>('#draft-text');
    const draftLink = document.querySelector<HTMLAnchorElement>('#draft-link');
    const topicField = document.querySelector<HTMLSelectElement>('#brief-service');
    const copyStatus = document.querySelector<HTMLElement>('#copy-status');
    if (form) form.hidden = false;
    const requested = new URL(window.location.href).searchParams.get('service');
    if (topicField && requested && Object.hasOwn(topics, requested)) topicField.value = requested;
    form?.addEventListener('input', () => { if (result) result.hidden = true; if (error) error.textContent = ''; });
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        const fields = new FormData(form);
        const draft = buildEmailDraft({ name: String(fields.get('name') ?? ''), email: String(fields.get('email') ?? ''), service: String(fields.get('service') ?? ''), message: String(fields.get('message') ?? '') });
        if (draftText) draftText.textContent = `To: info@legacymusicgroup.com\nSubject: ${draft.subject}\n\n${draft.body}`;
        if (draftLink) draftLink.href = draft.href;
        if (result) result.hidden = false;
        if (error) error.textContent = '';
        if (copyStatus) copyStatus.textContent = '';
        draftText?.focus();
      } catch (failure) { if (error) error.textContent = failure instanceof Error ? failure.message : 'Check the details and try again.'; }
    });
    document.querySelector('#copy-brief')?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(draftText?.textContent ?? ''); if (copyStatus) copyStatus.textContent = 'Copied. Paste it into an email to info@legacymusicgroup.com.'; }
      catch { if (copyStatus) copyStatus.textContent = 'Clipboard access is unavailable. Select and copy the draft text above, or open your email app.'; draftText?.focus(); }
    });
  </script>
</Layout>
