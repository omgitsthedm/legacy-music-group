---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Cta from '../components/Cta.astro';
import { business } from '../data/site';
const rates=[{name:'Recording',rate:'$75',unit:'/ hour',copy:'Vocals, voiceovers and podcasts. Legacy publishes a two-hour recording minimum.',href:'/services/recording/'},{name:'Mixing',rate:'$150+',unit:'starting rate',copy:'Discuss your tracks, references and required deliverables with the studio.',href:'/services/mixing-mastering/'},{name:'Custom production',rate:'$500',unit:'/ beat',copy:'A starting point for a custom production conversation. Agree on scope and rights first.',href:'/services/production/'}];
---
<Layout title="Recording and production starting rates" description="See Legacy Music Group’s published starting rates for recording, mixing and custom production. Confirm the current service, availability and total before booking."><div class="shell"><header class="page-heading"><p class="eyebrow">Plan the session</p><h1>A clear<br /><em>starting point.</em></h1><p>Published starting rates. The current service, session length and total are confirmed in Legacy’s booking system.</p></header><div class="rates-grid">{rates.map(r=><article class="rate"><h2>{r.name}</h2><strong>{r.rate} <span>{r.unit}</span></strong><p>{r.copy}</p><a class="text-link" href={r.href}>Explore the service <Arrow /></a></article>)}</div><p class="source-note">Rates checked against <a href={business.officialUrl}>Legacy’s main website</a> on October 9, 2026. Ask the studio about longer sessions, mastering, packages or a project quote. Current checkout terms govern your booking.</p><div class="section-bottom inline-links"><a class="button primary" href="/book/">Check current availability <Arrow /></a><a class="text-link" href="/contact/">Ask about your project</a></div></div><Cta /></Layout>
